# Dockerfile.gateway
# Go Gin API 网关

FROM golang:1.25-alpine AS builder

WORKDIR /build

COPY gateway/go.mod gateway/go.sum ./
RUN go mod download

COPY gateway/ .
RUN CGO_ENABLED=0 GOOS=linux go build -o gateway .

# 最终镜像：极小（~10MB）
FROM alpine:3.19
RUN apk add --no-cache ca-certificates

WORKDIR /app
COPY --from=builder /build/gateway .

EXPOSE 8080

CMD ["./gateway"]
